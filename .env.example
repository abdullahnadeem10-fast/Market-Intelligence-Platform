# Copy to .env (for Docker Compose) and/or backend/.env (for running the backend directly).
# Secrets live ONLY here, on the backend side. The frontend never receives them.

# --- Database (Docker Compose) ---
POSTGRES_USER=mip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mip
# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://mip:change-me@localhost:5432/mip

# --- Auth ---
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Data collection ---
COLLECTION_INTERVAL_MINUTES=60
# hackernews (HN Algolia API), gdelt (GDELT DOC 2.0 API), rss (company feeds). No API keys needed.
ENABLED_COLLECTORS=hackernews,gdelt,rss
# true = offline demo dataset about fictional companies (no network access needed)
COLLECTOR_DEMO_MODE=false
COLLECTOR_USER_AGENT=MarketIntelligencePlatform/1.0 (portfolio project; contact: you@example.com)
# Fetch company descriptions from Wikipedia when none is entered
ENRICHMENT_ENABLED=true
# Only used when running the API outside Docker (Docker runs the scheduler in the collector service)
SCHEDULER_ENABLED=true

# --- AI analysis (any OpenAI-compatible Chat Completions API) ---
# extractive = no LLM: rule-based digest of sources, zero tokens. openai = call LLM_BASE_URL.
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_CONTEXT_ITEMS=25
LLM_MAX_CONTEXT_CHARS=12000
# USD per 1M tokens, used for the approximate cost shown on the AI Usage page
LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60
# Reuse an identical analysis (same sources) for this many minutes
ANALYSIS_CACHE_MINUTES=360
